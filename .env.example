# ── WARAN ZONE configuration ───────────────────────────────────────────────
# Copy to .env.local and fill in only what you need. Never commit real secrets.

# Session signing secret. If omitted locally, one is generated in .data/.
# Required in production.
SESSION_SECRET=

# Comma separated emails that receive admin access.
ADMIN_EMAILS=

# Optional: create/reset this admin account on startup (local SQLite mode only).
ADMIN_PASSWORD=

# Optional: where the local SQLite file lives (default: ./.data/waran-zone.db)
DATA_DIR=

# ── Supabase (optional) ────────────────────────────────────────────────────
# When all three are set, Supabase is used for database and authentication.
# Run supabase/schema.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
